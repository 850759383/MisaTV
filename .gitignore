# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ---------------------------------------------------------------------------
# MisaTV open-source housekeeping
# ---------------------------------------------------------------------------

# Flutter / Dart build output and caches (regenerated by pub get / build)
/.dart_tool/
/build/
/.flutter-plugins-dependencies
**/__pycache__/

# Flutter tool output that embeds this machine's absolute paths
/windows/flutter/generated_config.cmake
/android/local.properties

# Vendored MDK (libmdk) SDK dump: upstream headers/libs, not referenced by the runner
/mdk-sdk/

# Local scratch / editor directories
/.trae-html-share-packages/
/.screenshots/

# Third-party binaries that are NOT redistributed with the source; see README "运行前准备"
/assets/aria2/aria2c.exe
/assets/jvm/shell-real/*.jar

